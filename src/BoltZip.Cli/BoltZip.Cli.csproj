<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BoltZip.Core\BoltZip.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>bz</AssemblyName>
    <RootNamespace>BoltZip.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))">..\BoltZip.App\Assets\boltzip.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
