<Window x:Class="BoltZip.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BoltZip" Height="700" Width="920" MinHeight="600" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#x26A1;" FontSize="24" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="BoltZip" FontSize="24" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="modern, hardware-optimized archiver" Foreground="{StaticResource SubtleBrush}"
                           VerticalAlignment="Bottom" Margin="12,0,0,4" />
            </StackPanel>
            <TextBlock x:Name="HardwareText" Grid.Column="1" Foreground="{StaticResource SubtleBrush}"
                       TextAlignment="Right" VerticalAlignment="Center" MaxWidth="360" TextWrapping="Wrap"
                       Text="Detecting hardware&#x2026;" />
        </Grid>

        <!-- Nav -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="CompressTab" Style="{StaticResource ToggleTab}" GroupName="Nav"
                             Content="Compress" IsChecked="True" Checked="OnTabChanged" />
                <RadioButton x:Name="ExtractTab" Style="{StaticResource ToggleTab}" GroupName="Nav"
                             Content="Extract" Margin="6,0,0,0" Checked="OnTabChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="InstallShellButton" Content="Add right-click menu" Click="OnInstallShell" />
                <Button x:Name="RemoveShellButton" Content="Remove" Margin="8,0,0,0" Click="OnRemoveShell" />
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="2">
            <!-- COMPRESS -->
            <Border x:Name="CompressPanel" Background="{StaticResource CardBrush}" CornerRadius="8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16" AllowDrop="True" Drop="OnInputDrop">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Files &amp; folders" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ListBox x:Name="InputList" Height="150" AllowDrop="True" Drop="OnInputDrop" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Add files&#x2026;" Click="OnAddFiles" />
                            <Button Content="Add folder&#x2026;" Margin="8,0,0,0" Click="OnAddFolder" />
                            <Button Content="Remove" Margin="8,0,0,0" Click="OnRemoveInput" />
                            <Button Content="Clear" Margin="8,0,0,0" Click="OnClearInputs" />
                        </StackPanel>

                        <TextBlock Text="Output format" FontWeight="SemiBold" Margin="0,16,0,6" />
                        <WrapPanel x:Name="FormatPanel">
                            <RadioButton Style="{StaticResource ChoicePill}" GroupName="Format" Content=".bz (encrypted)" Tag=".bz" IsChecked="True" Checked="OnFormatChanged" />
                            <RadioButton Style="{StaticResource ChoicePill}" GroupName="Format" Content=".zip" Tag=".zip" Checked="OnFormatChanged" />
                            <RadioButton Style="{StaticResource ChoicePill}" GroupName="Format" Content=".zst" Tag=".zst" Checked="OnFormatChanged" />
                            <RadioButton Style="{StaticResource ChoicePill}" GroupName="Format" Content=".tar" Tag=".tar" Checked="OnFormatChanged" />
                            <RadioButton Style="{StaticResource ChoicePill}" GroupName="Format" Content=".gz" Tag=".gz" Checked="OnFormatChanged" />
                            <RadioButton Style="{StaticResource ChoicePill}" GroupName="Format" Content=".bz2" Tag=".bz2" Checked="OnFormatChanged" />
                            <RadioButton Style="{StaticResource ChoicePill}" GroupName="Format" Content=".br" Tag=".br" Checked="OnFormatChanged" />
                        </WrapPanel>

                        <TextBlock Text="Optimization goal" FontWeight="SemiBold" Margin="0,10,0,6" />
                        <WrapPanel x:Name="GoalPanel">
                            <RadioButton Style="{StaticResource ChoicePill}" GroupName="Goal" Content="Max speed" Tag="MaxSpeed" Checked="OnGoalChanged" />
                            <RadioButton Style="{StaticResource ChoicePill}" GroupName="Goal" Content="Balanced" Tag="Balanced" IsChecked="True" Checked="OnGoalChanged" />
                            <RadioButton Style="{StaticResource ChoicePill}" GroupName="Goal" Content="Max ratio" Tag="MaxRatio" Checked="OnGoalChanged" />
                        </WrapPanel>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Password" VerticalAlignment="Center" Width="90" />
                            <PasswordBox x:Name="PasswordBox" Grid.Column="1" />
                        </Grid>
                        <TextBlock x:Name="PasswordHint" Text="Encryption uses XChaCha20-Poly1305 (only for .bz)."
                                   Foreground="{StaticResource SubtleBrush}" FontSize="11" Margin="90,4,0,0" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Output" VerticalAlignment="Center" Width="90" />
                            <TextBox x:Name="OutputPathBox" Grid.Column="1" />
                            <Button Grid.Column="2" Content="Browse&#x2026;" Margin="8,0,0,0" Click="OnBrowseOutput" />
                        </Grid>

                        <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="12" Margin="0,14,0,0"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Optimization plan" FontWeight="SemiBold" />
                                    <Button Content="Preview" HorizontalAlignment="Right" Padding="8,3" Click="OnPreviewPlan" />
                                </Grid>
                                <TextBlock x:Name="PlanText" Margin="0,8,0,0" Foreground="{StaticResource SubtleBrush}"
                                           TextWrapping="Wrap" Text="The engine auto-tunes threads, window size, buffers and codec to your machine. Click Preview." />
                            </StackPanel>
                        </Border>

                        <Button x:Name="CompressButton" Style="{StaticResource AccentButton}" Content="Compress"
                                HorizontalAlignment="Left" Margin="0,16,0,0" Click="OnCompress" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- EXTRACT -->
            <Border x:Name="ExtractPanel" Background="{StaticResource CardBrush}" CornerRadius="8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16"
                    Visibility="Collapsed" AllowDrop="True" Drop="OnArchiveDrop">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Archive" VerticalAlignment="Center" Width="90" />
                        <TextBox x:Name="ArchivePathBox" Grid.Column="1" />
                        <Button Grid.Column="2" Content="Browse&#x2026;" Margin="8,0,0,0" Click="OnBrowseArchive" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Extract to" VerticalAlignment="Center" Width="90" />
                        <TextBox x:Name="ExtractOutputBox" Grid.Column="1" />
                        <Button Grid.Column="2" Content="Browse&#x2026;" Margin="8,0,0,0" Click="OnBrowseExtractDir" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Password" VerticalAlignment="Center" Width="90" />
                        <PasswordBox x:Name="ExtractPasswordBox" Grid.Column="1" />
                        <CheckBox x:Name="OverwriteCheck" Grid.Column="2" Content="Overwrite" Margin="12,0,0,0" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="List contents" Click="OnListArchive" />
                        <Button x:Name="ExtractButton" Style="{StaticResource AccentButton}" Content="Extract"
                                Margin="8,0,0,0" Click="OnExtract" />
                    </StackPanel>

                    <TextBlock Text="Contents" FontWeight="SemiBold" Margin="0,14,0,6" />
                    <ListBox x:Name="EntryList" Height="230" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="ProgressBar" VerticalAlignment="Center" Minimum="0" Maximum="100" />
            <TextBlock x:Name="StatusText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource SubtleBrush}" Text="Ready" />
        </Grid>

        <!-- Footer -->
        <TextBlock Grid.Row="4" Margin="0,12,0,0" HorizontalAlignment="Center" Foreground="{StaticResource SubtleBrush}" FontSize="11">
            <Run Text="Created by Brian Santacruz &#x2014; " />
            <Hyperlink NavigateUri="https://briansantacruz.com" RequestNavigate="OnOpenWebsite" Foreground="{StaticResource AccentBrush}">
                briansantacruz.com
            </Hyperlink>
        </TextBlock>
    </Grid>
</Window>
