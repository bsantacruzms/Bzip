<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-boltzip">
    <comment>BoltZip archive</comment>
    <icon name="boltzip"/>
    <glob pattern="*.bz"/>
    <magic priority="60">
      <match type="string" value="BZ1" offset="0"/>
    </magic>
  </mime-type>
</mime-info>
