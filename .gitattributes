# Normalize every text file to LF in the repository. Only a handful of extensions
# used to be listed here, so everything else (csproj, axaml, sln, props, json,
# html, css, js, svg, wxs, manifest, LICENSE ...) stored its CRLF endings verbatim
# and showed up as a whole-file diff.
* text=auto

# Keep shell scripts LF so they run on macOS/Linux CI.
*.sh text eol=lf

# Windows-only text: keep CRLF in the working tree.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.rtf text eol=crlf

# Binary assets: never convert or diff.
*.png binary
*.ico binary
*.icns binary
*.exe binary
*.msi binary
*.dmg binary
*.zip binary
*.gz binary
